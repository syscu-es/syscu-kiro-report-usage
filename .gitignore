__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# generated reports and downloaded data may contain user e-mails: never commit them
kiro-report-*.html
kiro-report-*.json
.cache/

# local agent/tooling state: never commit
.claude/

# terraform (the lock file is committed; state and real tfvars never are)
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
